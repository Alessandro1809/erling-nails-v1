---
import { Image } from "astro:assets";
import icon from "@/assets/ENWhite.png";
---

<header class="site-header fixed inset-x-0 top-0 z-40 px-4 pt-4">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between rounded-full border border-white/45 bg-[#171313]/82 px-3 text-[#f7f5f2] shadow-[0_8px_28px_rgba(23,19,19,0.16)] backdrop-blur-xl">
    <a
      href="/"
      class="group flex min-w-0 items-center gap-3 rounded-full pr-3 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5"
      aria-label="Erling Nails homepage"
    >
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#8f1713]">
        <Image src={icon} alt="" class="h-6 w-auto" />
      </span>
      <span class="max-w-[150px] truncate text-sm font-semibold tracking-[0.02em] sm:max-w-none sm:text-base">
        Erling Nails
      </span>
    </a>

    <div class="hidden items-center gap-7 text-sm font-medium md:flex">
      <a href="/NailGallery" class="nav-link">Gallery</a>
      <a href="/About" class="nav-link">About</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="https://wa.link/8xem3n"
        target="_blank"
        rel="noreferrer"
        class="group inline-flex h-11 items-center gap-2 rounded-full bg-[#f7f5f2] py-1 pl-5 pr-1 text-sm font-semibold text-[#171313] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 active:scale-[0.98]"
      >
        <span>Book Now</span>
        <span class="grid h-9 w-9 place-items-center rounded-full bg-[#8f1713] text-[#f7f5f2] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
          <span aria-hidden="true">↗</span>
        </span>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle relative h-11 w-11 rounded-full border border-white/15 md:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<div id="mobile-nav" class="mobile-nav fixed inset-0 z-30 hidden bg-[#171313]/96 px-6 pb-8 pt-28 text-[#f7f5f2] backdrop-blur-xl md:hidden">
  <div class="flex h-full flex-col justify-between">
    <div class="grid gap-4 text-4xl font-semibold tracking-[-0.02em]">
      <a href="/NailGallery" class="mobile-nav-link">Gallery</a>
      <a href="/About" class="mobile-nav-link">About</a>
      <a href="#contact" class="mobile-nav-link">Contact</a>
    </div>
    <div class="grid gap-4">
      <a href="tel:+50670967912" class="text-lg text-[#e8e3de]">(+506) 7096 7912</a>
      <a
        href="https://wa.link/8xem3n"
        target="_blank"
        rel="noreferrer"
        class="inline-flex h-12 w-max items-center rounded-full bg-[#f7f5f2] px-6 text-sm font-semibold text-[#171313]"
      >
        Book Now
      </a>
    </div>
  </div>
</div>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const mobileNav = document.querySelector<HTMLElement>("#mobile-nav");
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link");

  function setMenu(open: boolean) {
    menuToggle?.setAttribute("aria-expanded", String(open));
    menuToggle?.classList.toggle("is-open", open);
    mobileNav?.classList.toggle("hidden", !open);
    document.documentElement.classList.toggle("overflow-hidden", open);
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    setMenu(!isOpen);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
</script>

<style>
  .nav-link {
    position: relative;
    color: rgb(247 245 242 / 0.78);
    transition: color 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    background: #f7f5f2;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover {
    color: #f7f5f2;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .menu-toggle span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1px;
    background: #f7f5f2;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      top 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-toggle span:first-child {
    top: 17px;
  }

  .menu-toggle span:last-child {
    top: 25px;
  }

  .menu-toggle.is-open span:first-child {
    top: 21px;
    transform: rotate(45deg);
  }

  .menu-toggle.is-open span:last-child {
    top: 21px;
    transform: rotate(-45deg);
  }
</style>

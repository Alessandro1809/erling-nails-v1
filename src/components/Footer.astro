---
import { Image } from "astro:assets";
import icon from "@/assets/ENWhite.png";
---

<footer class="footer-shell bg-[#171313] text-[#f7f5f2]">
  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-[1.15fr_0.85fr] md:py-24">
    <div>
      <div class="mb-8 flex items-center gap-3">
        <span class="grid h-11 w-11 place-items-center rounded-full bg-[#8f1713]">
          <Image src={icon} alt="" class="h-7 w-auto" />
        </span>
        <span class="text-lg font-semibold">Erling Nails</span>
      </div>
      <h2 class="max-w-3xl text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.03em] md:text-6xl">
        Manicure and pedicure care in Playas del Coco.
      </h2>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="https://wa.link/8xem3n"
          target="_blank"
          rel="noreferrer"
          class="group inline-flex h-12 w-max items-center gap-2 rounded-full bg-[#f7f5f2] py-1 pl-6 pr-1 text-sm font-semibold text-[#171313] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 active:scale-[0.98]"
        >
          <span>Book Now</span>
          <span class="grid h-10 w-10 place-items-center rounded-full bg-[#8f1713] text-[#f7f5f2] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a
          href="/NailGallery"
          class="inline-flex h-12 w-max items-center rounded-full border border-[#f7f5f2]/22 px-6 text-sm font-semibold text-[#f7f5f2] transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-[#f7f5f2]/60"
        >
          View Work
        </a>
      </div>
    </div>

    <div class="grid content-end gap-8 text-sm text-[#d8d0ca]">
      <div class="grid gap-3">
        <p class="font-semibold text-[#f7f5f2]">Location</p>
        <address class="not-italic leading-7">
          Five Star Salón & Spa<br />
          Playas del Coco, Guanacaste<br />
          Costa Rica
        </address>
      </div>
      <div class="grid gap-3">
        <p class="font-semibold text-[#f7f5f2]">Contact</p>
        <a class="transition-colors hover:text-[#f7f5f2]" href="tel:+50670967912">(+506) 7096 7912</a>
        <a class="transition-colors hover:text-[#f7f5f2]" href="https://www.facebook.com/share/1AZsuy7ysc/" target="_blank" rel="noreferrer">Facebook</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-[#f7f5f2]/12 pt-6 text-xs text-[#bfb6af]">
        <span>© 2026 Erling Nails</span>
        <a class="transition-colors hover:text-[#f7f5f2]" href="/About">About</a>
        <a class="transition-colors hover:text-[#f7f5f2]" href="/NailGallery">Gallery</a>
      </div>
    </div>
  </section>
</footer>
